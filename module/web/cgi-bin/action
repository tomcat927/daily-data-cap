#!/system/bin/sh
# WebUI 后端: 动作 + JSON 状态 (页面本体是 web/index.html, 由 httpd 直接服务)
# 入口: /cgi-bin/action?t=<token>[&do=...][&fmt=json]
DATA="/data/adb/daily_data_cap"
BB="/data/adb/magisk/busybox"
DUMP="/system/bin/dumpsys"
MODDIR="/data/adb/modules/daily_data_cap"
[ -f "$DATA/config" ] && . "$DATA/config"

Q() { printf '%s' "$QUERY_STRING" | tr '&' '\n' | sed -n "s/^$1=//p" | head -n 1; }

TOKEN="${WEBUI_TOKEN:-}"
if [ -z "$TOKEN" ] || [ "$(Q t)" != "$TOKEN" ]; then
  printf 'Status: 403 Forbidden\r\nContent-Type: text/plain; charset=utf-8\r\n\r\n403: token 无效'
  exit 0
fi

# ---- 动作: 写命令文件, 引擎 5 秒内执行; 完成后回首页 ----
DO="$(Q do)"
case "$DO" in
  lift_midnight) printf 'LIFT:MIDNIGHT\n'  > "$DATA/cmd" ;;
  lift_hardcap)  printf 'LIFT:HARDCAP\n'   > "$DATA/cmd" ;;
  lift_min)      printf 'LIFT:MINUTES:%s\n' "$(Q min)" > "$DATA/cmd" ;;
  block)         printf 'BLOCK\n'          > "$DATA/cmd" ;;
  reset)         printf 'RESET\n'          > "$DATA/cmd" ;;
  calib)         printf 'CALIB\n'          > "$DATA/cmd" ;;
  setthresh)
    V="$(Q v)"
    case "$V" in ''|*[!0-9]*) ;; *) printf 'SETTHRESH:%s\n' "$V" > "$DATA/cmd" ;; esac
    ;;
  settoken)
    V="$(Q v)"
    case "$V" in ''|*[!A-Za-z0-9]*) ;; *) printf 'SETTOKEN:%s\n' "$V" > "$DATA/cmd" ;; esac
    ;;
esac
[ -n "$DO" ] && { printf 'Location: /\r\n\r\n'; exit 0; }

# ---- 兼容旧的长网址入口 / 缺 fmt: 跳首页 ----
if [ "$(Q fmt)" != "json" ] && [ "$(Q fmt)" != "stats" ] && [ "$(Q fmt)" != "topapps" ] && [ "$(Q fmt)" != "appday" ]; then
  printf 'Location: /\r\n\r\n'
  exit 0
fi

# ---- 统计接口: 每日归档 + 最近事件 ----
if [ "$(Q fmt)" = "stats" ]; then
  DAYS_=$(tr '\n' ';' < "$DATA/daily.csv" 2>/dev/null)
  EVTS_=$(tail -n 12 "$DATA/events.log" 2>/dev/null | tr '\n' '~')
  printf 'Content-Type: application/json\r\n\r\n'
  printf '{"days":"%s","events":"%s"}' "$DAYS_" "$EVTS_"
  exit 0
fi

# ---- 今日应用排行 TopN (蜂窝, 本地口径=开机以来; 按需计算, 120s 缓存) ----
if [ "$(Q fmt)" = "topapps" ]; then
  printf 'Content-Type: application/json\r\n\r\n'
  CACHE="$DATA/topapps.cache"
  NOW_=$(date +%s)
  CT_=$(sed -n '1p' "$CACHE" 2>/dev/null)
  if [ -n "$CT_" ] && [ "$((NOW_ - CT_))" -le 120 ]; then
    printf '{"topapps":"%s","total_mb":"%s","days":"%s"}' \
      "$(sed -n '2p' "$CACHE")" "$(sed -n '3p' "$CACHE")" \
      "$(ls "$DATA/appstats" 2>/dev/null | grep -o '^[0-9]*' | sort -rn | tr '\n' ';')"
    exit 0
  fi
  APPF="$DATA/topapps.cache.raw"
  sh "$MODDIR/bin/appstats.sh" 2>/dev/null | head -n 11 > "$APPF"   # Top10 + TOTAL
  OUT_=""; TOTMB_="0"
  while read -r n v; do
    if [ "$n" = "TOTAL" ]; then TOTMB_="$v"; continue; fi
    OUT_="${OUT_}${n}:${v};"
  done < "$APPF"
  rm -f "$APPF"
  printf '%s\n%s\n%s\n' "$NOW_" "$OUT_" "$TOTMB_" > "$CACHE"
  printf '{"topapps":"%s","total_mb":"%s","days":"%s"}' "$OUT_" "$TOTMB_" \
    "$(ls "$DATA/appstats" 2>/dev/null | grep -o '^[0-9]*' | sort -rn | tr '\n' ';')"
  exit 0
fi

# ---- 历史某日的应用排行 ----
if [ "$(Q fmt)" = "appday" ]; then
  printf 'Content-Type: application/json\r\n\r\n'
  D_=$(Q d)
  case "$D_" in
    ????????) case "$D_" in *[!0-9]*) D_="" ;; esac ;;
    *) D_="" ;;
  esac
  F_="$DATA/appstats/$D_.csv"
  if [ -z "$D_" ] || [ ! -f "$F_" ]; then
    printf '{"date":"%s","apps":"","total_mb":"0"}' "$D_"
    exit 0
  fi
  TOT_=$($BB awk -F, '$1=="total"{print $2; exit}' "$F_")
  APPS_=$($BB awk -F, '$1!="total" && NF>=2{printf "%s:%s;", $1, $2}' "$F_")
  printf '{"date":"%s","apps":"%s","total_mb":"%s"}' "$D_" "$APPS_" "${TOT_:-0}"
  exit 0
fi

# ---- JSON 状态 ----
STATE="ACTIVE"; LIFT_MODE="-"
[ -f "$DATA/state" ] && . "$DATA/state"
USED=$(cat "$DATA/used_bytes" 2>/dev/null || echo 0)
THRESHOLD_MB="${THRESHOLD_MB:-900}"
HARD_CAP_MB="${HARD_CAP_MB:-1024}"
IFACE=$(head -n 1 "$DATA/ifinfo" 2>/dev/null)
USED_MB=$($BB awk -v b="$USED" 'BEGIN{printf "%.1f", b/1048576}')

# 校对状态
CALIB_ON=0
[ -n "${FLOW_MOBILE:-}" ] && [ -n "${FLOW_PWD_HASH:-}" ] && CALIB_ON=1
CT=""; CU=""; CR=""; CD=""
if [ -f "$DATA/carrier" ]; then
  CT=$($BB awk 'NR==1{print $1" "$2}' "$DATA/carrier" 2>/dev/null)
  CU=$($BB awk 'NR==1{print $3}' "$DATA/carrier" 2>/dev/null)
  CR=$($BB awk 'NR==1{print $4}' "$DATA/carrier" 2>/dev/null)
  CD=$($BB awk -v c="${CU:-0}" -v b="$USED" 'BEGIN{printf "%+.1f", c - b/1048576}')
fi

printf 'Content-Type: application/json\r\n\r\n'
printf '{"state":"%s","mode":"%s","used_mb":"%s","threshold_mb":%s,"hardcap_mb":%s,"iface":"%s","calib_on":%s,"calib_time":"%s","carrier_used":"%s","carrier_remain":"%s","diff":"%s"}' \
  "$STATE" "$LIFT_MODE" "$USED_MB" "$THRESHOLD_MB" "$HARD_CAP_MB" "$IFACE" \
  "$CALIB_ON" "$CT" "$CU" "$CR" "$CD"
